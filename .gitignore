# Project-specific large/binary assets
data/models/*
!data/models/.gitkeep
# Ses referansları: persona klon klipleri (ref_*.wav) TRACK edilir (taşınabilirlik
# için yeni PC'de hazır gelsin), gerisi (test/karşılaştırma _*.wav, mp3) ignore.
data/voices/**/*.wav
data/voices/**/*.mp3
!data/voices/*/ref_*.wav
!data/voices/.gitkeep
# TTS cache: sese-özgü + yeniden üretilebilir → track ETME (yeni PC ilk çalışmada üretir).
data/tts_cache/*
!data/tts_cache/.gitkeep
data/responses/vector_store/
# Ses seçim örnekleri (voice_try.py üretir; yerel dinleme için, repoya gerek yok)
data/voice_samples/
src/tts/voices/*.wav
src/tts/voices/*.mp3
!src/tts/voices/.gitkeep
# NOT: src/llm/responses/*.json kaynak veri — track edilir.

# Logs
*.log
logs/

# Local overrides
local_settings.py
config.local.yaml

# Claude Code workspace files (per-clone)
.claude/

# Smoke test artifacts
uvicorn.out
uvicorn.err

# Ham ses kayıtları (klon kaynağı; dönüştürülmüş ref_*.wav repoda yeterli)
afc/

# Test ses çıktıları + ham klon kaynakları (kaynak değil; ref_*.wav zaten track)
data/*.wav
data/voices/**/*.m4a
data/voices/**/*.aac

# Ses uretim/test calisma klasorleri (yerel; Vercel'e gitmesin)
