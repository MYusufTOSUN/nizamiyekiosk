# BilimFest environment overrides
# Tüm uygulama ayarları config.yaml dosyasından gelir.
# Aşağıdaki env değişkenleri config.yaml'daki değerleri override eder.
# Format: BFEST__<section>__<key>=value   (nested için __ delimiter)

# Örnekler:
# BFEST__APP__ENVIRONMENT=development
# BFEST__STT__PROVIDER=mock
# BFEST__LLM__PROVIDER=mock
# BFEST__TTS__PROVIDER=mock
# BFEST__LIPSYNC__PROVIDER=mock
# BFEST__METRICS__LOG_LEVEL=DEBUG
